	<artifactId>3D_Objects_Counter_Plus</artifactId>
	<!--
	  Versioning policy: see VERSIONING.md.
	  First digit = new feature set.
	  Second digit = major rework or large optimization.
	  Third digit = bug fix or small tweak/optimization.
	-->
	<version>0.2.0</version>

	<name>3D Objects Counter+</name>
	<description>Fiji/ImageJ plugin for 3D object counting with morphology filters, optional XY fractal, composite-shape, arborization and Sholl measurements, plus recursive folder batch analysis and within-batch descriptive scoring.</description>
	<url>https://github.com/Jay2owe/3DObjectsCounterPlus</url>
	<inceptionYear>2026</inceptionYear>
	<organization>
		<name>UK Dementia Research Institute at Imperial College London</name>
		<url>https://ukdri.ac.uk/centres/imperial</url>
	</organization>
	<!--
	  The licence of the combined distributed work, which is what this element
	  declares. Jamie Malcolm's own source in this repository is BSD-3-Clause
	  (see LICENSE.BSD-3-Clause), but the plugin links GPLv3+ libraries -
	  sc.fiji:3D_Objects_Counter and org.framagit.mcib3d:mcib3d-core - and
	  cannot run without them, so the artifact that is distributed and run is
	  GPL-3.0-or-later. `provided` scope is a build-time concern and does not
	  change that. See LICENSING.md.
	-->
	<licenses>
		<license>
			<name>GNU General Public License v3.0 or later</name>
			<url>https://www.gnu.org/licenses/gpl-3.0.html</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

